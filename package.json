{
  "name": "matta",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p scripts --noEmit",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "check:models": "tsx --env-file-if-exists=.env.local scripts/check-models.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed-users.ts && tsx --env-file=apps/demo-bank/.env.local scripts/seed-sandboxes.ts",
    "scenarios:validate": "echo 'not yet (Phase 3)' && exit 1",
    "eval": "echo 'not yet (Phase 4)' && exit 1",
    "deploy:all": "bash infra/deploy.sh",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@google/genai": "^2.29.0",
    "@matta/core": "workspace:^",
    "@types/node": "^26.6.5",
    "firebase-admin": "^14.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.1"
  }
}
