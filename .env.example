# MATTA environment variables. Copy the relevant section into the file named in its header.
# Never commit real values. On Cloud Run, secrets come from Secret Manager (Phase 0B).
# Auth everywhere is Application Default Credentials:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project <project>

# ─────────────────────────────────────────────────────────────
# Root scripts  →  ./.env.local   (pnpm check:models, pnpm seed)
# ─────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=useful-cathode-450302-f0
# Vertex AI location for Gemini. "global" serves the newest models.
GOOGLE_CLOUD_LOCATION=global
# Model IDs. Never Gemini 2.5 (check:models refuses /2\.5/).
MODEL_FAST=
MODEL_SMART=
# Demo user passwords (min 8 chars). Shared per role; only go into the submission form.
SEED_PASSWORD_CUSTOMER=
SEED_PASSWORD_CONTACT=
SEED_PASSWORD_OPERATOR=

# ─────────────────────────────────────────────────────────────
# apps/web  →  apps/web/.env.local
# ─────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=useful-cathode-450302-f0
GOOGLE_CLOUD_LOCATION=global
MODEL_FAST=
MODEL_SMART=
# Web's Firestore database: "web-dev" locally, "(default)" on Cloud Run.
FIRESTORE_DATABASE_ID=web-dev
WEB_URL=http://localhost:3000
BANK_URL=http://localhost:8081
# inline = evaluate holds in-process; cloud = Cloud Tasks.
TASKS_MODE=inline
# Skip Google ID tokens web→bank. Refused when NODE_ENV=production.
S2S_DEV_INSECURE=true
# Demo clock, sandbox reset, red-team console.
DEMO_MODE=true
# Firebase web app config (Console → Project settings → Your apps). Public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Browser → bank base URL for C/K routes (cancel, decisions, mandate). Bank CORS allows WEB_URL only.
NEXT_PUBLIC_BANK_URL=http://localhost:8081
# Shows the demo clock / reset controls (the bank enforces DEMO_MODE itself).
NEXT_PUBLIC_DEMO_MODE=true

# ─────────────────────────────────────────────────────────────
# apps/demo-bank  →  apps/demo-bank/.env.local
# ─────────────────────────────────────────────────────────────
PORT=8081
GOOGLE_CLOUD_PROJECT=useful-cathode-450302-f0
# Bank's Firestore database: "bank-dev" locally, "bank" on Cloud Run.
FIRESTORE_DATABASE_ID=bank-dev
WEB_URL=http://localhost:3000
# Audience of incoming Google ID tokens.
BANK_URL=http://localhost:8081
# Comma-separated service accounts allowed on service (W) routes.
S2S_ALLOWED_SA=sa-web@useful-cathode-450302-f0.iam.gserviceaccount.com
S2S_DEV_INSECURE=true
TASKS_MODE=inline
DEMO_MODE=true
# Cloud mode only (TASKS_MODE=cloud): queue path and the service account that signs OIDC tokens (sa-bank).
TASKS_QUEUE=
TASKS_SA_EMAIL=
# Comma-separated service accounts allowed on /internal/* (Cloud Tasks OIDC; sa-bank).
TASKS_ALLOWED_SA=sa-bank@useful-cathode-450302-f0.iam.gserviceaccount.com
# Optional override; defaults to <repo>/policy/system-policy.yaml.
# POLICY_PATH=
